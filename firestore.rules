rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isEditor() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && exists(/databases/$(database)/documents/editors/$(request.auth.uid));
    }
    function validExpression() {
      return request.resource.data.keys().hasAll(['text', 'hidden', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['text', 'hidden', 'createdAt', 'updatedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 200
        && request.resource.data.hidden is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt == request.time;
    }
    match /expressions/{expressionId} {
      allow read: if isEditor() || resource.data.hidden == false;
      allow create: if isEditor() && validExpression()
        && request.resource.data.createdAt == request.time;
      allow update: if isEditor() && validExpression()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isEditor();
    }
    match /editors/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, write: if false;
    }
  }
}
